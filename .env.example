# Base de datos (docker-compose.yml expone Postgres en 5432)
DATABASE_URL="postgresql://emprendeai:emprendeai@localhost:5432/emprendeai?schema=public"

# NextAuth
AUTH_SECRET="genera-un-secreto-con-openssl-rand-base64-32"

# Capa de IA (Parte 10/17 de la spec) — chat EMPRENDE AI (v1.1).
# Sin esta key, el panel de chat se muestra pero avisa que falta configurar.
ANTHROPIC_API_KEY=""
# Opcional — por defecto usa claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# Benchmarking Temporal (spec §20) — OPCIONAL. Sin esto, la captura mensual
# de snapshots funciona igual (perezosa, al abrir el Dashboard). Si lo
# configurás, podés apuntar un cron externo (Vercel Cron, GitHub Actions...)
# a GET /api/cron/snapshot con "Authorization: Bearer <CRON_SECRET>" para una
# captura de fin de mes más precisa.
CRON_SECRET=""

# Seed de PRODUCCIÓN (npm run db:seed:prod, prisma/seed-production.ts) —
# crea el primer usuario ADMIN. Nunca se usan estas dos para el seed de
# desarrollo (npm run db:seed), que trae su propio admin/demo hardcodeado
# SOLO para uso local. Si no están configuradas, el seed de producción no
# crea ningún admin — no falla el deploy, solo avisa por consola.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
