// EMPRENDE AI — Modelo de datos (MVP + v1.1 + v1.2)
//
// Subconjunto de la sección 26 de la especificación funcional/técnica:
// - MVP (§30 fase 1): auth, onboarding, modelo del negocio, estructura de
//   costos, inversión inicial, escenarios.
// - v1.1: precificación inteligente + curva de demanda, chat EMPRENDE AI.
// - v1.2: tipo de cambio + costos de importación (Multimoneda), matriz de
//   riesgos y sensibilidad se calculan en memoria (no requieren tablas).
//
// Entidades de fases posteriores (Shareholders, FundingRounds, Valuations, ...)
// se agregan en v2.0 cuando ese módulo se implemente — no se crean tablas
// vacías por adelantado.
//
// Multi-tenancy: toda tabla de negocio cuelga de Company. Las server actions
// siempre resuelven la Company del usuario autenticado (lib/actions/auth-guard.ts)
// antes de leer o escribir — spec §26/§28.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cuentas y planes (§25)
// ---------------------------------------------------------------------------

enum PlanCode {
  FREE
  STARTER
  PRO
  BUSINESS
  CONSULTOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  planCode     PlanCode @default(FREE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies Company[]
}

// ---------------------------------------------------------------------------
// Onboarding y negocio (§1, §3)
// ---------------------------------------------------------------------------

enum UserType {
  EMPRENDEDOR
  PROFESIONAL_INDEPENDIENTE
  STARTUP
  PYME
  EMPRESA_ESTABLECIDA
  FRANQUICIA
  INVERSIONISTA
}

enum BusinessType {
  RESTAURANTE
  HOTEL
  TURISMO
  COMERCIO
  ECOMMERCE
  SERVICIOS
  CONSULTORIA
  EDUCACION
  INMOBILIARIO
  MANUFACTURA
  TECNOLOGIA
  SALUD
  BELLEZA
  TRANSPORTE
  AGRICULTURA
  OTRO
}

enum OperatingStage {
  OPERANDO
  NO_OPERANDO
  ETAPA_IDEA
}

model Company {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  country               String
  city                  String
  currency              String         @default("BOB")
  sector                String?
  userType              UserType
  businessType          BusinessType
  startDate             DateTime?
  employeeCount         Int?
  operatingStage        OperatingStage
  /// Tasa de impuesto a la utilidad usada por el Financial Engine (§8, EBIT → Utilidad Neta).
  /// Supuesto por defecto editable en Perfil — se marca como tal en la UI (spec §0.3).
  taxRatePct            Float          @default(25)
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  products        Product[]
  fixedCosts      FixedCost[]
  variableCosts   VariableCost[]
  investments     Investment[]
  scenarios       Scenario[]
  aiConversations AIConversation[]
  exchangeRates   ExchangeRate[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Modelo del negocio (§3)
// ---------------------------------------------------------------------------

enum ProductType {
  PRODUCTO
  SERVICIO
}

/// Origen del costo (spec §3) — determina si el producto usa el submódulo de
/// Costos de Importación (§4, fórmula 6.3) para calcular su costo variable.
enum CostOrigin {
  LOCAL
  IMPORTADO
}

model Product {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  category         String?
  type             ProductType @default(PRODUCTO)
  price            Float
  variableCost     Float
  unitsSoldMonthly Float       @default(0)
  commissionPct    Float       @default(0)
  taxPct           Float       @default(0)
  discountPct      Float       @default(0)
  costOrigin       CostOrigin  @default(LOCAL)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  variableCostLinks VariableCost[]
  pricePoints       PricePoint[]
  importCosts       ImportCost[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Curva de demanda (§6) — pares históricos (precio, cantidad vendida) que
// alimentan la regresión lineal de demanda y el cálculo de elasticidad
// (fórmula 21.11). Dato real cargado por el usuario, nunca inventado.
// ---------------------------------------------------------------------------

model PricePoint {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  quantity   Float
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Multimoneda (§15) — tipo de cambio y costos de importación (§4, fórmula 6.3)
// ---------------------------------------------------------------------------

enum ExchangeRateType {
  OFICIAL
  PARALELO
  PROYECTADO
}

/// Un tipo de cambio "vigente" por combinación (origen, destino, tipo) —
/// spec §15.1: "Tipo de cambio: oficial, paralelo, y proyectado (campos
/// separados)". Editable, no un histórico completo en el MVP+v1.2.
model ExchangeRate {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrency  String
  toCurrency    String
  rateType      ExchangeRateType
  rate          Float
  effectiveDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, fromCurrency, toCurrency, rateType])
}

/// Costos de importación de un producto marcado como CostOrigin.IMPORTADO
/// (spec §4 "Submódulo Costos de Importación"). `quantity` son las unidades
/// que cubre este lote/embarque, para prorratear el costo total a costo por
/// unidad (fórmula 6.3/21.13).
model ImportCost {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  originCurrency      String
  fobCost             Float
  freight             Float    @default(0)
  insurance           Float    @default(0)
  tariffPct           Float    @default(0)
  nationalizationFees Float    @default(0)
  bankFee             Float    @default(0)
  quantity            Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Estructura de costos (§4)
// ---------------------------------------------------------------------------

enum CostPeriodicity {
  MENSUAL
  ANUAL
}

enum FixedCostCategory {
  ALQUILER
  SUELDOS
  SERVICIOS
  SOFTWARE
  SEGUROS
  ADMINISTRACION
  MARKETING
  OTROS
}

model FixedCost {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    FixedCostCategory @default(OTROS)
  amount      Float
  periodicity CostPeriodicity   @default(MENSUAL)
  growthPct   Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
}

enum VariableCostCategory {
  MATERIA_PRIMA
  COMISIONES
  EMPAQUE
  TRANSPORTE
  PRODUCCION
  TRANSACCION
  OTROS
}

/// Costo variable expresado por unidad (amountPerUnit) o como % de ventas
/// (pctOfSales) — spec §4. Si se asocia a un producto, se suma a su costo
/// variable unitario en el motor financiero.
model VariableCost {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  category      VariableCostCategory @default(OTROS)
  amountPerUnit Float?
  pctOfSales    Float?
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([companyId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inversión inicial (§5)
// ---------------------------------------------------------------------------

enum InvestmentCategory {
  EQUIPAMIENTO
  INFRAESTRUCTURA
  TECNOLOGIA
  MOBILIARIO
  VEHICULOS
  LICENCIAS
  MARKETING_INICIAL
  CAPITAL_DE_TRABAJO
  GASTOS_PREOPERATIVOS
  OTROS
}

model Investment {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  InvestmentCategory
  name      String
  amount    Float
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Escenarios (§9)
// ---------------------------------------------------------------------------

enum ScenarioType {
  PESIMISTA
  BASE
  OPTIMISTA
}

/// Los tres escenarios se crean automáticamente al completar el onboarding
/// con deltas por defecto (spec §9) y quedan editables por el usuario.
model Scenario {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ScenarioType
  salesDeltaPct Float        @default(0)
  priceDeltaPct Float        @default(0)
  costDeltaPct  Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, type])
}

// ---------------------------------------------------------------------------
// EMPRENDE AI — Chat consultor (§10)
// ---------------------------------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
}

/// Historial de conversación con el chat EMPRENDE AI. La IA solo redacta
/// `content`; los datos que cita siempre provienen de un snapshot del
/// Financial Engine (nunca calcula ni inventa cifras — spec §0.3/§10/§27).
model AIConversation {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([companyId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
