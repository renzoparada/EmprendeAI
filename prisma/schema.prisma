// EMPRENDE AI — Modelo de datos (MVP + v1.1 + v1.2 + v2.0 + piezas finales)
//
// Subconjunto de la sección 26 de la especificación funcional/técnica:
// - MVP (§30 fase 1): auth, onboarding, modelo del negocio, estructura de
//   costos, inversión inicial, escenarios.
// - v1.1: precificación inteligente + curva de demanda, chat EMPRENDE AI.
// - v1.2: tipo de cambio + costos de importación (Multimoneda), matriz de
//   riesgos y sensibilidad se calculan en memoria (no requieren tablas).
// - v2.0: valoración (DCF/múltiplos/Berkus/Scorecard/VC Method), Cap Table +
//   simulador de rondas + waterfall, Multinegocio, Panel Admin, CONSULTOR.
// - Piezas finales: Sales Forecast/embudo comercial, Mis Metas, Business
//   Plan con IA. Ver README para lo que queda deliberadamente fuera
//   (pagos/suscripciones reales, colaboración cross-account de CONSULTOR).
//
// Multi-tenancy: toda tabla de negocio cuelga de Company. Las server actions
// siempre resuelven la Company del usuario autenticado (lib/actions/auth-guard.ts)
// antes de leer o escribir — spec §26/§28.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cuentas y planes (§25)
// ---------------------------------------------------------------------------

enum PlanCode {
  FREE
  STARTER
  PRO
  BUSINESS
  CONSULTOR
}

/// Rol de plataforma (spec §25, Panel Administrador) — no confundir con el
/// tipo de usuario del negocio (`UserType`, más abajo). Todo usuario nuevo
/// es USER; ADMIN se otorga manualmente (ver prisma/seed.ts).
enum PlatformRole {
  USER
  ADMIN
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  planCode     PlanCode     @default(FREE)
  role         PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  companies             Company[]
  /// Empresas de terceros a las que este usuario recibió acceso (plan CONSULTOR, spec §25).
  accessGrantsReceived  CompanyAccessGrant[] @relation("AccessGrantsReceived")
  /// Accesos que este usuario otorgó, como dueño, sobre sus propias empresas.
  accessGrantsGiven     CompanyAccessGrant[] @relation("AccessGrantsGiven")
}

// ---------------------------------------------------------------------------
// Onboarding y negocio (§1, §3)
// ---------------------------------------------------------------------------

enum UserType {
  EMPRENDEDOR
  PROFESIONAL_INDEPENDIENTE
  STARTUP
  PYME
  EMPRESA_ESTABLECIDA
  FRANQUICIA
  INVERSIONISTA
}

enum BusinessType {
  RESTAURANTE
  HOTEL
  TURISMO
  COMERCIO
  ECOMMERCE
  SERVICIOS
  CONSULTORIA
  EDUCACION
  INMOBILIARIO
  MANUFACTURA
  TECNOLOGIA
  SALUD
  BELLEZA
  TRANSPORTE
  AGRICULTURA
  OTRO
}

enum OperatingStage {
  OPERANDO
  NO_OPERANDO
  ETAPA_IDEA
}

model Company {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  country               String
  city                  String
  currency              String         @default("BOB")
  sector                String?
  userType              UserType
  businessType          BusinessType
  startDate             DateTime?
  employeeCount         Int?
  operatingStage        OperatingStage
  /// Tasa de impuesto a la utilidad usada por el Financial Engine (§8, EBIT → Utilidad Neta).
  /// Supuesto por defecto editable en Perfil — se marca como tal en la UI (spec §0.3).
  taxRatePct            Float          @default(25)
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  products             Product[]
  fixedCosts           FixedCost[]
  variableCosts        VariableCost[]
  investments          Investment[]
  financingPlans       FinancingPlan[]
  monthlySnapshots     MonthlySnapshot[]
  businessSimulations  BusinessSimulation[]
  scenarios            Scenario[]
  aiConversations      AIConversation[]
  exchangeRates        ExchangeRate[]
  valuationAssumptions ValuationAssumptions?
  shareholders         Shareholder[]
  fundingRounds        FundingRound[]
  capTableEntries      CapTableEntry[]
  salesFunnel          SalesFunnel?
  goal                 Goal?
  businessPlanSections BusinessPlanSection[]
  accessGrants         CompanyAccessGrant[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Acceso Cross-Account del plan CONSULTOR (spec §25) — el dueño de una
// empresa le otorga acceso completo (lectura + escritura) a otro usuario ya
// registrado, sin compartir credenciales. v1: sin distinción viewer/editor
// (ver README "Alcance" — hacerlo a medias en la UI sería engañoso sobre
// seguridad). Solo el dueño puede otorgar/revocar (`requireCompanyOwner`,
// nunca el propio guard general `requireCompany`, que sí reconoce estos
// grants para todo lo demás).
// ---------------------------------------------------------------------------

model CompanyAccessGrant {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("AccessGrantsReceived", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("AccessGrantsGiven", fields: [grantedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Modelo del negocio (§3)
// ---------------------------------------------------------------------------

enum ProductType {
  PRODUCTO
  SERVICIO
}

/// Origen del costo (spec §3) — determina si el producto usa el submódulo de
/// Costos de Importación (§4, fórmula 6.3) para calcular su costo variable.
enum CostOrigin {
  LOCAL
  IMPORTADO
}

model Product {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  category         String?
  type             ProductType @default(PRODUCTO)
  price            Float
  variableCost     Float
  unitsSoldMonthly Float       @default(0)
  commissionPct    Float       @default(0)
  taxPct           Float       @default(0)
  discountPct      Float       @default(0)
  costOrigin       CostOrigin  @default(LOCAL)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  variableCostLinks VariableCost[]
  pricePoints       PricePoint[]
  importCosts       ImportCost[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Curva de demanda (§6) — pares históricos (precio, cantidad vendida) que
// alimentan la regresión lineal de demanda y el cálculo de elasticidad
// (fórmula 21.11). Dato real cargado por el usuario, nunca inventado.
// ---------------------------------------------------------------------------

model PricePoint {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  quantity   Float
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Multimoneda (§15) — tipo de cambio y costos de importación (§4, fórmula 6.3)
// ---------------------------------------------------------------------------

enum ExchangeRateType {
  OFICIAL
  PARALELO
  PROYECTADO
}

/// Un tipo de cambio "vigente" por combinación (origen, destino, tipo) —
/// spec §15.1: "Tipo de cambio: oficial, paralelo, y proyectado (campos
/// separados)". Editable, no un histórico completo en el MVP+v1.2.
model ExchangeRate {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromCurrency  String
  toCurrency    String
  rateType      ExchangeRateType
  rate          Float
  effectiveDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, fromCurrency, toCurrency, rateType])
}

/// Costos de importación de un producto marcado como CostOrigin.IMPORTADO
/// (spec §4 "Submódulo Costos de Importación"). `quantity` son las unidades
/// que cubre este lote/embarque, para prorratear el costo total a costo por
/// unidad (fórmula 6.3/21.13).
model ImportCost {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  originCurrency      String
  fobCost             Float
  freight             Float    @default(0)
  insurance           Float    @default(0)
  tariffPct           Float    @default(0)
  nationalizationFees Float    @default(0)
  bankFee             Float    @default(0)
  quantity            Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Estructura de costos (§4)
// ---------------------------------------------------------------------------

enum CostPeriodicity {
  MENSUAL
  ANUAL
}

enum FixedCostCategory {
  ALQUILER
  SUELDOS
  SERVICIOS
  SOFTWARE
  SEGUROS
  ADMINISTRACION
  MARKETING
  OTROS
}

model FixedCost {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    FixedCostCategory @default(OTROS)
  amount      Float
  periodicity CostPeriodicity   @default(MENSUAL)
  growthPct   Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
}

enum VariableCostCategory {
  MATERIA_PRIMA
  COMISIONES
  EMPAQUE
  TRANSPORTE
  PRODUCCION
  TRANSACCION
  OTROS
}

/// Costo variable expresado por unidad (amountPerUnit) o como % de ventas
/// (pctOfSales) — spec §4. Si se asocia a un producto, se suma a su costo
/// variable unitario en el motor financiero.
model VariableCost {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  category      VariableCostCategory @default(OTROS)
  amountPerUnit Float?
  pctOfSales    Float?
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([companyId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inversión inicial (§5)
// ---------------------------------------------------------------------------

enum InvestmentCategory {
  EQUIPAMIENTO
  INFRAESTRUCTURA
  TECNOLOGIA
  MOBILIARIO
  VEHICULOS
  LICENCIAS
  MARKETING_INICIAL
  CAPITAL_DE_TRABAJO
  GASTOS_PREOPERATIVOS
  OTROS
}

model Investment {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  InvestmentCategory
  name      String
  amount    Float
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Financiamiento (§14) — préstamo, socios, inversionista, crowdfunding,
// capital propio. Todas las fuentes comparten la misma matemática de
// amortización (Financing Engine); `type` es solo la etiqueta que el usuario
// elige para identificar la fuente de capital.
// ---------------------------------------------------------------------------

enum FinancingType {
  PRESTAMO_BANCARIO
  SOCIOS
  INVERSIONISTA
  CROWDFUNDING
  CAPITAL_PROPIO
}

enum GraceType {
  NINGUNA
  SOLO_INTERES
  TOTAL
}

model FinancingPlan {
  id                    String        @id @default(cuid())
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  type                  FinancingType @default(PRESTAMO_BANCARIO)
  principal             Float
  annualInterestRatePct Float         @default(0)
  termMonths            Int
  gracePeriodMonths     Int           @default(0)
  graceType             GraceType     @default(NINGUNA)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Benchmarking Temporal (§20/§13: "promedio histórico del propio negocio") —
// foto mensual real del Financial Engine, nunca tipeada a mano. `source`
// distingue una captura automática (al abrir el Dashboard, si no existe la
// del mes en curso) de una recaptura manual explícita del usuario.
// ---------------------------------------------------------------------------

enum SnapshotSource {
  AUTOMATICO
  MANUAL
}

model MonthlySnapshot {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodYear       Int
  periodMonth      Int

  ventas           Float
  costoVentas      Float
  utilidadBruta    Float
  gastosOperativos Float
  ebitda           Float
  utilidadNeta     Float
  margenNetoPct    Float
  flujoNeto        Float
  /// null cuando el punto de equilibrio no es calculable ese mes (margen de contribución 0) — nunca se guarda Infinity.
  breakEvenAmount  Float?

  source           SnapshotSource @default(AUTOMATICO)
  capturedAt       DateTime       @default(now())

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Business Simulator (§20) — proyección hacia adelante, mes a mes, sobre los
// datos reales actuales. Se guarda el CONJUNTO DE SUPUESTOS con nombre para
// poder volver a él; los resultados nunca se persisten, se recalculan en
// vivo cada vez (mismo principio que el Business Plan: nunca una cifra
// congelada).
// ---------------------------------------------------------------------------

model BusinessSimulation {
  id                        String   @id @default(cuid())
  companyId                 String
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                      String
  horizonMonths             Int      @default(12)
  monthlySalesGrowthPct     Float    @default(0)
  priceAdjustmentPct        Float    @default(0)
  annualInflationPct        Float    @default(0)
  staffCount                Int      @default(0)
  avgSalary                 Float    @default(0)
  monthlyStaffGrowthPct     Float    @default(0)
  monthlyMarketingGrowthPct Float    @default(0)
  exchangeRateShockPct      Float    @default(0)
  includeFinancing          Boolean  @default(true)
  /// Array de {month, name, amount} — validado con Zod al leer/escribir (spec §0.3: nunca confiar un JSON sin validar).
  investmentEvents          Json     @default("[]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Escenarios (§9)
// ---------------------------------------------------------------------------

enum ScenarioType {
  PESIMISTA
  BASE
  OPTIMISTA
}

/// Los tres escenarios se crean automáticamente al completar el onboarding
/// con deltas por defecto (spec §9) y quedan editables por el usuario.
model Scenario {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ScenarioType
  salesDeltaPct Float        @default(0)
  priceDeltaPct Float        @default(0)
  costDeltaPct  Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, type])
}

// ---------------------------------------------------------------------------
// EMPRENDE AI — Chat consultor (§10)
// ---------------------------------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
}

/// Historial de conversación con el chat EMPRENDE AI. La IA solo redacta
/// `content`; los datos que cita siempre provienen de un snapshot del
/// Financial Engine (nunca calcula ni inventa cifras — spec §0.3/§10/§27).
model AIConversation {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@index([companyId])
}

/// `inputTokens`/`outputTokens` solo se completan en mensajes ASSISTANT
/// (vienen de `response.usage` de la API de Anthropic) — alimentan el Panel
/// Admin › Uso de IA (spec §25 "uso de IA/tokens"). `null` en mensajes USER
/// o si la IA no estaba configurada cuando se generó la respuesta.
model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Valoración de empresas (§16.1, fórmulas 21.5-21.9)
// ---------------------------------------------------------------------------

/// Supuestos de valoración editables por el usuario — spec §21.5: "permitir
/// tasa manual justificada, marcada como supuesto del usuario". Un registro
/// por empresa, con valores por defecto razonables y nunca inventados por IA.
model ValuationAssumptions {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // CAPM / WACC (21.5)
  riskFreeRatePct Float @default(5)
  beta            Float @default(1)
  marketReturnPct Float @default(10)
  costOfDebtPct   Float @default(8)
  debtRatioPct    Float @default(0)

  // DCF (21.6)
  fclGrowthPct      Float @default(5)
  terminalGrowthPct Float @default(3)
  projectionYears   Int   @default(5)

  // Múltiplos y capitalización de utilidades (21.7) — null = sin dato
  // confiable, nunca se inventa un múltiplo (spec §13/§21.5).
  evEbitdaMultiple Float?
  evSalesMultiple  Float?
  peMultiple       Float?

  // Berkus (21.8) — cada factor respeta `berkusFactorCap` en el engine.
  berkusFactorCap     Float @default(500000)
  berkusIdea          Float @default(0)
  berkusPrototype     Float @default(0)
  berkusTeam          Float @default(0)
  berkusRelationships Float @default(0)
  berkusInitialSales  Float @default(0)

  // Scorecard (21.8) — 100% = igual al comparable promedio.
  scorecardComparableAvg          Float?
  scorecardManagementScorePct     Float  @default(100)
  scorecardOpportunityScorePct    Float  @default(100)
  scorecardProductScorePct        Float  @default(100)
  scorecardCompetitionScorePct    Float  @default(100)
  scorecardMarketingScorePct      Float  @default(100)
  scorecardNeedInvestmentScorePct Float  @default(100)

  // VC Method (21.8)
  vcExitValueProjected     Float?
  vcRequiredReturnMultiple Float  @default(10)
  vcInvestmentAmount       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Socios y Cap Table (§16.2-16.4, fórmulas 21.9-21.10)
// ---------------------------------------------------------------------------

enum ShareholderType {
  FOUNDER
  INVERSIONISTA
  ESOP
  OTRO
}

model Shareholder {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  type      ShareholderType @default(FOUNDER)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  capTableEntries CapTableEntry[]

  @@index([companyId])
}

/// Ronda de inversión ya cerrada/registrada (histórico). El simulador de
/// rondas (spec §16.3) no persiste nada — solo esta tabla, cuando el
/// usuario decide "confirmar" una ronda simulada.
model FundingRound {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  date              DateTime @default(now())
  preMoneyValuation Float
  investmentAmount  Float
  pricePerShare     Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  capTableEntries CapTableEntry[]

  @@index([companyId])
}

/// Participación accionaria de un socio (spec §16.2). `isPreferred` +
/// `liquidationPreferenceMultiple` alimentan el waterfall de salida (21.10).
model CapTableEntry {
  id                            String        @id @default(cuid())
  companyId                     String
  company                       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shareholderId                 String
  shareholder                   Shareholder   @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  shares                        Float
  isPreferred                   Boolean       @default(false)
  liquidationPreferenceMultiple Float         @default(1)
  investedAmount                Float         @default(0)
  fundingRoundId                String?
  fundingRound                  FundingRound? @relation(fields: [fundingRoundId], references: [id], onDelete: SetNull)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  @@index([companyId])
  @@index([shareholderId])
}

// ---------------------------------------------------------------------------
// Sales Forecast / Embudo comercial (§7, fórmula 21.12)
// ---------------------------------------------------------------------------

/// Snapshot editable del embudo comercial del mes actual — spec §7. Un
/// registro por empresa (se sobrescribe, no es una serie histórica en esta
/// fase). Alimenta conversión por etapa, CAC, LTV y, junto con Mis Metas,
/// cuántos leads/vendedores se necesitan para alcanzar un objetivo.
model SalesFunnel {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads                    Float    @default(0)
  contactos                Float    @default(0)
  prospectos               Float    @default(0)
  reuniones                Float    @default(0)
  cotizaciones             Float    @default(0)
  negociaciones            Float    @default(0)
  ventas                   Float    @default(0)
  avgTicket                Float    @default(0)
  marketingSpend           Float    @default(0)
  purchaseFrequencyPerYear Float    @default(1)
  customerLifetimeYears    Float    @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Mis Metas (§11)
// ---------------------------------------------------------------------------

enum GoalTargetType {
  UTILIDAD_NETA
  VENTAS
}

/// Meta del usuario ("Quiero ganar Bs 100.000 al mes") — spec §11. Un
/// registro activo por empresa; el Goal Planner Engine calcula ventas,
/// unidades, clientes, leads y vendedores necesarios a partir de esto.
model Goal {
  id                  String         @id @default(cuid())
  companyId           String         @unique
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  targetType          GoalTargetType @default(UTILIDAD_NETA)
  targetAmount        Float
  targetConversionPct Float          @default(20)
  leadsPerVendedor    Float          @default(50)
  unitsPerCustomer    Float          @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Business Plan con IA (§18)
// ---------------------------------------------------------------------------

/// Secciones cualitativas del plan de negocio — texto libre editado por el
/// usuario (opcionalmente con un borrador inicial de IA). Las secciones
/// basadas en datos reales (Inversión, Proyección financiera, Riesgos) NO
/// se guardan acá: se renderizan siempre en vivo desde los motores
/// determinísticos, nunca como texto congelado (spec §18: "todo conectado
/// al modelo financiero real, no generado de forma aislada").
enum BusinessPlanSectionKey {
  RESUMEN_EJECUTIVO
  PROBLEMA
  SOLUCION
  PRODUCTO
  MERCADO
  CLIENTE_OBJETIVO
  MODELO_NEGOCIO
  COMPETENCIA
  MARKETING
  VENTAS
  OPERACIONES
  EQUIPO
  ESTRATEGIA
}

model BusinessPlanSection {
  id        String                 @id @default(cuid())
  companyId String
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       BusinessPlanSectionKey
  content   String                 @default("")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([companyId, key])
}
